# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# os-draw je zaseban paket; build ide u public/os-app/draw i commituje se
/os-draw/node_modules

# privatni materijal za /uml (rad koleginice, slajdovi kursa); repo je javan
/docs/uml/

# Chrome profil iz testova (headless --user-data-dir); ne ide u repo
/prof/
